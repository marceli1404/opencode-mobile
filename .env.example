# OpenCode Mobile - Environment Variables
# Copy this file to .env and adjust values

# OpenCode Server
OPENCODE_PORT=4096
OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_SERVER_USERNAME=opencode
# REQUIRED - Change this to a strong password!
OPENCODE_SERVER_PASSWORD=your-strong-password-here
# Optional: Comma-separated CORS origins
OPENCODE_CORS=

# Mobile UI
VITE_PORT=3000

# Optional: PWA / Service Worker
VITE_PWA_ENABLED=false